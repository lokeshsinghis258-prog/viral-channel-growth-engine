# Backend Configuration
PORT=3000
NODE_ENV=development

# Database
DB_PATH=./data/app.db

# JWT Secret (change this in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Optional: YouTube API (free tier available, not required for demo)
YOUTUBE_API_KEY=

# Optional: Instagram Graph API (requires Meta developer account, not required for demo)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Demo Mode (set to true to use sample data)
DEMO_MODE=true
